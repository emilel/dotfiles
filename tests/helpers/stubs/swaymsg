#!/bin/sh
# Record swaymsg calls to $SWAY_LOG; answer queries:
#   --pretty ... get_*  -> $SWAY_PRETTY     (human format)
#   ... get_workspaces  -> $SWAY_WORKSPACES (falls back to $SWAY_JSON)
#   ... get_*           -> $SWAY_JSON       (default [])
# Everything else (workspace/rename/exec ...) just succeeds.
[ -n "${SWAY_LOG:-}" ] && printf '%s\n' "$*" >>"$SWAY_LOG"
case "$*" in
    *--pretty*get_*) printf '%s\n' "${SWAY_PRETTY:-}" ;;
    *get_workspaces*) printf '%s' "${SWAY_WORKSPACES:-${SWAY_JSON:-[]}}" ;;
    *get_*) printf '%s' "${SWAY_JSON:-[]}" ;;
    *) exit 0 ;;
esac
