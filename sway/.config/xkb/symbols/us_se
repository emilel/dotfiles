// US, but the three keys that are åäö on a Swedish board type åäö, so swedish
// can be written without the rest of the se symbols moving. What they replace
// ([{ ;: '") moves to AltGr (right Alt) on the same key. Found by sway via
// libxkbcommon's ~/.config/xkb include path.
default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"
    name[Group1] = "English (US, Swedish letters)";

    key <AD11> {[ aring,      Aring,      bracketleft, braceleft ]};
    key <AC10> {[ odiaeresis, Odiaeresis, semicolon,   colon     ]};
    key <AC11> {[ adiaeresis, Adiaeresis, apostrophe,  quotedbl  ]};

    include "level3(ralt_switch)"
};
