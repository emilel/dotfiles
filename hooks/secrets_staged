#!/bin/sh
# pre-commit: refuse commits whose staged changes look like they contain
# secrets. bootstrap.sh copies this into this repo's .git/hooks/pre-commit;
# copy it into any other repo that wants it.
command -v gitleaks >/dev/null || {
    echo "pre-commit: gitleaks not installed (bootstrap.sh terminal installs it)" >&2
    exit 1
}
exec gitleaks git --pre-commit --staged --redact --no-banner
