{
  "layer": "top",
  "position": "bottom",
  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-right": [
    "custom/claude",
    "custom/display",
    "custom/kb",
    "custom/network",
    "bluetooth",
    "backlight",
    "wireplumber",
    "memory",
    "battery",
    "clock",
    "tray"
  ],
  "battery": {
    "states": {
      "good": 95,
      "warning": 40,
      "critical": 15
    },
    "format-full": "CHR {capacity} %",
    "format-charging": "CHR {capacity} %",
    "format-discharging": "BAT {capacity} %",
    "tooltip-format": ""
  },
  "clock": {
    "format": "{:%Y-%m-%d %H:%M:%S}",
    "interval": 1
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "SCR {percent} %",
    "tooltip": false
  },
  "memory": {
    "format": "RAM {avail} GiB",
    "interval": 5,
    "states": {
      "warning": 3,
      "critical": 0.5
    }
  },
  "wireplumber": {
    "format": "VOL {volume} %",
    "format-muted": "VOL MUTE",
    "max-volume": 100,
    "on-click": "pavucontrol -t 3",
    "tooltip": false
  },
  "custom/claude": {
    "format": "TB {}",
    "exec": "~/.scripts/tmux_claude_status.sh",
    "interval": 2,
    "tooltip": false
  },
  "custom/display": {
    "format": "DPY {}",
    "exec": "~/.scripts/display_toggle.sh status",
    "on-click": "~/.scripts/display_toggle.sh",
    "interval": 5,
    "tooltip": false
  },
  "bluetooth": {
    "format-disabled": "",
    "format-off": "",
    "format-on": "BT {num_connections}",
    "format-connected": "BT {num_connections}",
    "on-click": "foot --override=locked-title=yes --title waybar-menu -e ~/.scripts/bluetooth_menu.sh",
    "on-click-right": "foot --override=locked-title=yes --title waybar-menu -e bluetuith"
  },
  "custom/kb": {
    "format": "KB {}",
    "return-type": "json",
    "exec": "~/.scripts/kb_toggle.sh status",
    "on-click": "~/.scripts/kb_toggle.sh && pkill -RTMIN+8 waybar",
    "interval": 5,
    "signal": 8,
    "tooltip": false
  },
  "custom/network": {
    "format": "{}",
    "exec": "~/.scripts/net_status.sh",
    "interval": 5,
    "tooltip": false,
    "on-click": "foot --override=locked-title=yes --title waybar-menu -e ~/.scripts/wifi_menu.sh",
    "on-click-right": "foot --override=locked-title=yes --title waybar-menu -e nmtui"
  },
  "style": "~/.config/waybar/style.css"
}
